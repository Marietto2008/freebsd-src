# CLAUDE-WSL -- Claude 03/11/2026. SOLO DIAGNOSI per FreeBSD nella VM di WSL2 (blocco di virtio_pci sul vPCI di
# Hyper-V): GENERIC + DDB, con l'ingresso nel debugger dalla seriale (CR ~ ^B).
include GENERIC
ident	CLAUDE-WSL
options 	DDB
options 	ALT_BREAK_TO_DEBUGGER
# Memoria condivisa di WSLg (VAIL): il file system virtio "wslg" mappato in DAX, /dev/wslgshm.
device		wslgshm
