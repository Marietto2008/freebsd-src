# ---------------------------------------------------------------------------
# L'INGRESSO AUDIO -- "rec=/dev/dsp" non si puo' usare   [claude 19/9/2026]
# ---------------------------------------------------------------------------
# /dev/dsp e' il dispositivo PREDEFINITO, e qui punta all'unita' 12:
# l'uscita HDMI Intel, che sa solo RIPRODURRE. Provato: in scrittura si
# apre, in lettura risponde "Operation not supported". bhyve apre `rec`,
# fallisce, e scatta la assert in hda_init (pci_hda.c:352).
#
# Si sceglie il primo dispositivo che DICHIARA di saper registrare.
recdev=$(awk -F: '/^pcm[0-9]+:/ && /rec/ {sub("pcm","",$1); print "/dev/dsp" $1; exit}' /dev/sndstat)
if [ -z "$recdev" ]; then
	echo "nessuna scheda sa registrare: la VM restera' senza microfono"
	recdev=/dev/null
fi
echo "audio: play=/dev/dsp (default, unit $(sysctl -n hw.snd.default_unit)) rec=$recdev"

