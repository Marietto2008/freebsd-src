# NIDIFICAZIONE (Claude 16/10/2026): il vmm NESTED va caricato DAL BOOT.
# Lo scambio a CALDO del modulo e' impossibile: dentro vmm-restore.ko c'e'
# anche pci/ppt, e le GPU (3/0/x + 4/0/x) legate a ppt dai pptdevs tengono il
# modulo "Device busy" -> kldunload fallisce sempre. Quindi il nested sta in
# /boot/kernel/vmm-restore.ko (loader.conf: vmm_load=YES, vmm_name=vmm-restore)
# e si carica all'avvio con le GPU gia' su ppt, pulite.
#
# Per aggiornare il modulo nested dopo una ricompilazione:
#   cp -n /boot/kernel/vmm-restore.ko /boot/kernel/vmm-restore.ko.nonnested
#   cp /mnt/linuxulator2/vm/wsl2/fbsd/stage/current/vmm-restore.ko \
#      /boot/kernel/vmm-restore.ko
#   reboot
# Per tornare al vmm non-nested: ripristina il .nonnested e riavvia.
NESTED_VMM=/mnt/linuxulator2/vm/wsl2/fbsd/stage/current/vmm-restore.ko
loaded=$(kldstat -v 2>/dev/null | awk -F'[()]' '/vmm-restore\.ko \(/{print $2; exit}')
if [ -z "$loaded" ]; then
	echo "vmm non caricato: controlla vmm_load=YES in /boot/loader.conf"
	exit 1
fi
if ! cmp -s "$loaded" "$NESTED_VMM"; then
	echo "ATTENZIONE: il vmm caricato ($loaded) NON coincide col nested"
	echo "aggiornato ($NESTED_VMM). Installa in /boot e riavvia l'host:"
	echo "  cp -n /boot/kernel/vmm-restore.ko /boot/kernel/vmm-restore.ko.nonnested"
	echo "  cp '$NESTED_VMM' /boot/kernel/vmm-restore.ko && reboot"
	exit 1
fi
echo "vmm nested aggiornato e attivo: $loaded"

sleep 2

