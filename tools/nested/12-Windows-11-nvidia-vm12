# NB: il ricarico del vmm nested lo fa il blocco piu' sotto, per ID e solo a
# zero VM attive ('kldunload vmm' a mano fallirebbe: il file e' vmm-restore.ko).

vms="$(ls /dev/vmm/*)"
vncs="$(ps ax | awk '/vncviewer [0]/{print $6}')"
session="${vm##*/}"
echo $vms
echo $vncs
echo $session
bhyvectl --vm=vm0:12 --destroy

# NIDIFICAZIONE (Claude 16/10/2026): la virtualizzazione annidata vive nel
# vmm NESTED. E' l'albero di ottobre + il codice nested, quindi porta GIA'
# dentro le tue fix GPU/HLT: vmx.c e' IDENTICO al tree gpu-16 sui marcatori
# del passthrough (MASK_HWINTR 3/3, VM_CAP_IPI_EXIT 2/2), piu' ~96 righe nested.
# Carica QUESTO modulo (non il mirrorfix) PRIMA di avviare, se non e' gia' su:
#   kldstat | grep vmm    # dev'essere il vmm-restore.ko di nested-work
#   # se no:  kldload /mnt/linuxulator2/vm/nested-work/stage/current/vmm-restore.ko

NESTED_VMM=/mnt/linuxulator2/vm/nested-work/stage/current/vmm-restore.ko
# Il vmm caricato DEVE essere questo (nested). Se ne e' su un altro -- tipico:
# /boot/kernel/vmm-restore.ko, che NON e' nested e fa fallire x86.nested_virt --
# lo scambio. MA solo a zero VM attive, se no kldunload romperebbe le VM vive.
# RICARICO SEMPRE il modulo nested dal file. Confrontare per PERCORSO non basta:
# il file puo' essere stato RICOMPILATO tra un avvio e l'altro (stesso percorso,
# contenuto diverso) e un modulo stale fa fallire x86.nested_virt. Solo a 0 VM:
# dentro vmm-restore.ko c'e' anche pci/ppt, al ricarico si riaggancia via pptdevs.
if ls /dev/vmm/* >/dev/null 2>&1; then
	echo "Ci sono VM attive: non posso ricaricare il vmm. Distruggile:"
	ls /dev/vmm/
	echo "  bhyvectl --vm=NOME --destroy   (poi rilancia)"
	exit 1
fi
# scarico il vmm corrente PER ID (il file e' vmm-restore.ko, non "vmm")
id=$(kldstat 2>/dev/null | awk '/[ \t]vmm-restore\.ko/{print $1; exit}')
if [ -n "$id" ]; then
	echo "scarico il vmm corrente (id $id) per ricaricare il nested aggiornato"
	kldunload -i "$id" || { echo "kldunload id $id fallito"; exit 1; }
fi
echo "carico il vmm nested $NESTED_VMM"
kldload "$NESTED_VMM" || { echo "kldload del vmm nested fallito"; exit 1; }
echo "vmm nested attivo: $(kldstat -v 2>/dev/null | awk -F'[()]' '/vmm-restore\.ko \(/{print $2; exit}')"

sleep 10

