# F2b — L2: intercetti, interrupt, MSR. UN TEST PER RIGA (un QEMU per test).
# kut-run.sh --nested kut-f2b.list
# Il nome (1a colonna) finisce nel nome del file di log: niente '/'.
# nome | file.flat | args | qemu_params | smp | mem | timeout
IO_bitmap             | vmx.flat | I/O_bitmap             | -cpu max | 1 | 1024 | 60
instruction_intercept | vmx.flat | instruction_intercept  | -cpu max | 1 | 1024 | 60
interrupt             | vmx.flat | interrupt              | -cpu max | 1 | 1024 | 60
nmi_hlt               | vmx.flat | nmi_hlt                | -cpu max | 1 | 1024 | 60
debug_controls        | vmx.flat | debug_controls         | -cpu max | 1 | 1024 | 60
MSR_switch            | vmx.flat | MSR_switch             | -cpu max | 1 | 1024 | 60
vmmcall               | vmx.flat | vmmcall                | -cpu max | 1 | 1024 | 60
disable_RDTSCP        | vmx.flat | disable_RDTSCP         | -cpu max | 1 | 1024 | 60
