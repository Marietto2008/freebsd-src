# nested.env — configurazione di tools/nested/build.sh
# Copia in tools/nested/nested.env e adatta. NON committare nested.env.

# Albero FreeBSD isolato (clone, ramo nested-vmx). Mai /usr/src.
SRC=/mnt/linuxulator2/vm/wsl2/fbsd/freebsd-nested

# Albero QEMU isolato (clone, ramo nested-vmx). Mai qemu-new/qemu-old.
QEMU_SRC=/mnt/linuxulator2/vm/wsl2/fbsd/qemu-nested

# Config del kernel in esecuzione: deve avere INVARIANTS/WITNESS (VMMSNOOP).
KERNCONF=VMMSNOOP

# Dir di build del kernel da cui il modulo prende opt_global.h (INVARIANTS/WITNESS).
#  - Compile-check: va bene l'obj del kernel gia' costruito da /usr/src.
#  - Build fedele: fai prima `make -C $SRC buildkernel KERNCONF=VMMSNOOP`
#    e punta qui l'obj del clone.
KERNBUILDDIR=/usr/obj/usr/src/amd64.amd64/sys/VMMSNOOP

# Prefisso delle obj dir (le build vi scrivono; e' permesso).
MAKEOBJDIRPREFIX=/usr/obj

# Staging: TUTTO l'output va qui. Niente install di sistema.
STAGE=/mnt/linuxulator2/vm/wsl2/fbsd/stage

# CPU dedicate ai collaudi (le usa Marietto in load.sh/kut-run.sh, non build.sh).
TEST_CPUS=6,7
