#pragma D option quiet
#pragma D option switchrate=10hz
/*
 * ptpad-fbt.d -- Claude 27/10/2026, pareri #103 §4 / #105 §3.2. Diagnostica di PERCORSO,
 * READ-ONLY, per la sessione H1 del test ptpad. Attesta che l'emulazione di un'istruzione di
 * L2 ha attraversato il ramo che aggiorna gli A/D delle PTE ordinarie di L2.
 *
 *   vm_handle_inst_emul  = ingresso nell'emulatore (il ramo VEPT_MMIO -> VM_EXITCODE_INST_EMUL):
 *                          prova di MMIO_PATH_COVERED insieme al contatore nested_ept_mmio_emulated.
 *   _vm_gla2gpa          = il walk software che CONTIENE ptp_hold e le cmpset di PG_A/PG_M.
 *                          ptp_hold NON ha sonda FBT propria (incorporato, verificato con
 *                          `dtrace -l`): _vm_gla2gpa e' il piu' vicino punto sondabile, quindi
 *                          l'etichetta e' PTP_WALK_PATH_CORRELATED, non una prova diretta di
 *                          ptp_hold (parere #105 §3.2).
 *
 * NON e' l'oracolo: l'oracolo architetturale sta in L1 (la EPT violation vista o no). Questa
 * traccia aggiunge solo la correlazione di percorso. Emette eventi con timestamp e tid; il
 * runner li correla alla finestra attiva di ogni caso (come per il contatore) e compila la riga
 * `FBT mmio=<0|1> ptp=<0|1>` del log combinato letto da ptpad_an.py.
 *
 * Uso: dtrace -s ptpad-fbt.d <pid del bhyve>    (solo quel processo; nessuna abilitazione fuori)
 * A freddo: dtrace -e -s ptpad-fbt.d 1    (compila e basta; NON abilita, NESSUNA VM)
 */
BEGIN { printf("== FBT PRONTA == pid=%d\n", $1); }

fbt:vmm-restore:vm_handle_inst_emul:entry
/ pid == $1 /
{
	@mmio = count();
	printf("FBTEV t=%d tid=%d k=mmio\n", timestamp, tid);
}

fbt:vmm-restore:_vm_gla2gpa:entry
/ pid == $1 /
{
	@walk = count();
	printf("FBTEV t=%d tid=%d k=walk\n", timestamp, tid);
}

END
{
	printa("FBT CONTA mmio=%@d\n", @mmio);
	printa("FBT CONTA walk=%@d\n", @walk);
	printf("== FBT CHIUSA ==\n");
}
